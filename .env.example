# ============================================================================
# WurxMediaHub, environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for the DEV Supabase
# project. `.env.local` is gitignored; this file is not, so never put a real
# key in here.
#
# RULE: only values that are safe to ship inside the public browser bundle may
# be prefixed with VITE_. Anything else, service-role keys, webhook secrets,
# API tokens, belongs in Supabase Edge Function secrets, never here.
# ============================================================================

# Supabase project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key, the "sb_publishable_..." one, NOT the legacy
# "eyJ..." anon JWT. Safe to expose: it grants nothing on its own, because every
# table is protected by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=

# SMOOTH SCROLL (Lenis). OFF unless this says exactly `on`.
#
# Leave it blank or unset and the app behaves exactly as it does today: the
# provider is mounted but inert, and `lenis` is not even in the bundle. Set it
# to `on` to turn smooth scroll on for everyone in that build.
#
# To try it in ONE browser without a rebuild, run this in the console and
# reload:   localStorage.setItem('wx.smooth-scroll', 'on')
# To force it off again:   localStorage.setItem('wx.smooth-scroll', 'off')
#
# It is never on for somebody with "reduce motion" set, and never on the Paid
# Collabs route. See docs/guides/MOTION.md.
VITE_SMOOTH_SCROLL=

# Google Stitch API key, used ONLY by the Stitch MCP server in `.mcp.json`, not
# by the app. No VITE_ prefix, so it never reaches the browser bundle. Claude
# Code reads it from the Windows user environment, not from this file; see
# "MCP servers" in docs/OPERATIONS.md. Kept here because that is where the key
# was first stored.
STITCH_API=

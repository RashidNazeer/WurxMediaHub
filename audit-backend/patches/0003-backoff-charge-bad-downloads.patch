+    .order('finished_at', { ascending: false })
+    .limit(10);
+  let run = 0;
+  for (const b of (data ?? []) as Array<{ error: string | null }>) {
+    if (!isEnvError(b.error)) break;
+    run += 1;
+  }
+  return run;
+}

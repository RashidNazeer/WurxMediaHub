+/**
+ * How many environmental batches in a row, all failing to download, before the
+ * videos in the latest one are charged after all. See `chargesAttempt`.
+ */
+export const SOURCE_CHARGE_AFTER = 3;
+
+/**
+ * Whether an unplaced video should be charged an attempt.
+ *
+ * `confidentCount` is how many videos in the batch got a real answer, and
+ * `envRun` how many environmental batches in a row this one makes (0 when it is
+ * not one). Both default to 0, which is the old behaviour.
+ *
+ * A model failure in a batch of more than one is never charged: the free quota
+ * can die part way through a batch, so a good video fails alongside a bad one.
+ *
+ * A DOWNLOAD failure is different, because "could not download this link" is
+ * what a blocked server and a DELETED or PRIVATE video both say. Never charging
+ * it left two bad videos unable to run out of attempts: they always shared a
+ * batch, so they were never charged, never failed, and were probed once an hour
+ * for ever (simulated: a queue of 172 with 7 bad videos left 29 stuck, 22 of
+ * them good videos starved behind the cooldown). So it IS charged when
+ *   - other videos in the batch DID download, which shows the server is fine
+ *     and this link is the problem; or
+ *   - the whole-batch failure has repeated SOURCE_CHARGE_AFTER times running,
+ *     which is as long as a real block is worth protecting the queue from, and
+ *     is how bad videos at the TAIL of a queue, with no good ones left to
+ *     compare against, finally run out.
+ */
+export function chargesAttempt(
+  reason: string | null | undefined,
+  nVideos: number,
+  confidentCount = 0,
+  envRun = 0,
+): boolean {
+  if (nVideos <= 1) return true;
+  const cause = causeOf(reason);
+  if (cause === 'video') return true;
+  if (cause === 'source') return confidentCount > 0 || envRun >= SOURCE_CHARGE_AFTER;
+  return false;
 }
 

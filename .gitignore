# ============================================================================
# Secrets, nothing matching these may EVER be committed.
# The only env file that belongs in Git is .env.example, which holds names
# and placeholder values but no real keys.
# ============================================================================
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
*.local
.vite

# Tooling caches
.turbo
.eslintcache
coverage

# Playwright verification screenshots, regenerated by scripts/verify/verify-page.mjs
.playwright

# Design-review screenshots. Regenerated on demand by scripts/shots/shots*.mjs, and
# retina PNGs of a whole dashboard run to megabytes a time.
shots/

# Vercel, .vercel holds the local project link, not secrets, but it is
# machine-specific so it does not belong in the repo.
.vercel

# Supabase CLI local state (the migrations themselves ARE committed)
supabase/.branches
supabase/.temp

# Claude Code local state. Permission grants are machine-specific and embed
# absolute paths from whoever approved them, so they are noise in the repo.
.claude

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

.vercel
